# ============================================================
# MBK Tech Studio — Environment Configuration (.env.example)
# ============================================================

# Application Environment
NODE_ENV=development # development | production | test
PORT=4133

# Local Environment Simulation
localenv=true # true for local development, false for production
site=main # 'main' (mbktech.org) or 'other' (download domain simulation)

# Database Configuration (Dual-Database Support)
DB_TYPE=postgres # postgres | sqlite
SQLITE_PATH=./data/mbktech.org.db
NEON_POSTGRES=postgresql://user:password@ep-sample-pooler.region.neon.tech/dbname?sslmode=require

# Portal Version Control (JSON formatted release info)
PortalVersionControlJson={"latestVersion":"1.0.0","downloadUrl":"https://mbktech.org/download","mandatory":false}

# Security & Anti-Bot Protection (MBK Shield)
BOT_PROTECTION_SECRET=your-secure-random-hmac-secret-salt-here

# Optional: Cloudflare Turnstile CAPTCHA Integration
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Health Testing Secret Key
HEALTH_TEST_KEY=1234