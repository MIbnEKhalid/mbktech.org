{
  "name": "mbktech.org",
  "version": "2.0.5",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "start:sqlite": "cross-env DB_TYPE=sqlite node src/server.js",
    "dev:sqlite": "cross-env DB_TYPE=sqlite nodemon src/server.js",
    "db:init:postgres": "node scripts/initDb.js --type=postgres",
    "db:init:sqlite": "node scripts/initDb.js --type=sqlite",
    "test": "vitest run",
    "build:css": "tailwindcss -i src/styles/tailwind.css -o public/assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i src/styles/tailwind.css -o public/assets/css/tailwind.css --watch"
  },
  "author": "Muhammad Bin Khalid",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-handlebars": "^8.0.1",
    "express-rate-limit": "^7.5.1",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.9",
    "mbkauthe": "latest",
    "node-cache": "^5.1.2",
    "pg": "^8.13.3",
    "sitemap": "^8.0.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/supertest": "^7.2.1",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "body-parser": "^1.20.6",
    "qs": "^6.16.0"
  }
}
