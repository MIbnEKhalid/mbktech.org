<!-- Page hero -->
<section class="relative overflow-hidden bg-slate-50">
    <div class="container relative py-16 text-center md:py-20">
        <span class="inline-flex items-center gap-2 rounded-full bg-primary-50 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-primary-600 ring-1 ring-primary-100">
            <i class="lni lni-shield"></i> Legal
        </span>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight md:text-5xl">Privacy Policy</h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-500">How we collect, use, store, and protect your information.</p>
    </div>
</section>

<!-- Content (markdown rendered) -->
<section class="section">
    <div class="container max-w-3xl">
        <div class="prose prose-slate prose-lg max-w-none">
            {{{privacyContent}}}
        </div>
    </div>
</section>
