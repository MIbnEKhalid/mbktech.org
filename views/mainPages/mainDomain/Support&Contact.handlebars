<link rel="stylesheet" href="/Assets/Style/tickets.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<section class="ticket-form-container">
    <div class="form-hero">
        <div class="form-hero-icon"><i class="fas fa-headset"></i></div>
        <h1>Support &amp; Contact</h1>
        <p>Need help? Have feedback? We'd love to hear from you.</p>
    </div>

    <form id="ticketSupportForm" class="ticket-form" novalidate>
        <!-- Name + Email row -->
        <div class="form-row">
            <div class="field flex-1">
                <label class="label required">Name</label>
                <input class="input" type="text" name="UserName" placeholder="Your name" required>
            </div>
            <div class="field flex-1">
                <label class="label required">Email</label>
                <input class="input" type="email" name="Email" placeholder="you@example.com" required>
            </div>
        </div>

        <!-- Subject -->
        <div class="field">
            <label class="label required">What's this about?</label>
            <div class="select">
                <select class="input" name="Subject" id="subjectSelect" required>
                    <option value="" disabled selected>Choose a topic...</option>
                    <option value="Support">Technical Support</option>
                    <option value="Feedback">Feedback</option>
                    <option value="Collaboration">Collaboration</option>
                    <option value="Get Quote">Get a Quote</option>
                    <option value="General Inquiry">General Inquiry</option>
                </select>
            </div>
        </div>

        <!-- Support type (Support only) -->
        <div class="conditional-field" data-show="Support">
            <div class="field">
                <label class="label required">Support Type</label>
                <div class="select">
                    <select class="input" name="support">
                        <option value="" disabled selected>What kind of support?</option>
                        <option value="Docs">Documentation Help</option>
                        <option value="Technical">Technical Issue</option>
                        <option value="CopyRightIssue">Copyright Concern</option>
                        <option value="BugReportingFeatureRequests">Bug Report / Feature Request</option>
                        <option value="other">Something Else</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Service type (Get Quote only) -->
        <div class="conditional-field" data-show="Get Quote">
            <div class="field">
                <label class="label required">Service</label>
                <div class="select">
                    <select class="input" name="service">
                        <option value="" disabled selected>Which service?</option>
                        <option value="WebDev-Basic">Web Dev - Basic (PKR 5,000)</option>
                        <option value="WebDev-FullStack">Web Dev - Full Stack (PKR 10-15k)</option>
                        <option value="Technical-Consulting">Technical Consulting (Free)</option>
                        <option value="Maintenance">Maintenance (PKR 1,000-2,000/mo)</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Phone (Support, Collaboration, Get Quote) -->
        <div class="conditional-field" data-show="Support,Collaboration,Get Quote">
            <div class="field">
                <label class="label">Phone Number <span class="label-hint">(optional)</span></label>
                <input class="input" type="tel" name="Number" placeholder="+92 300 1234567">
            </div>
        </div>

        <!-- Rating (Feedback only) -->
        <div class="conditional-field" data-show="Feedback">
            <div class="field">
                <label class="label required">Rate your experience</label>
                <div class="star-rating" id="starRating">
                    <input type="radio" name="stars" value="5" id="s5"><label for="s5"><i class="fas fa-star"></i></label>
                    <input type="radio" name="stars" value="4" id="s4"><label for="s4"><i class="fas fa-star"></i></label>
                    <input type="radio" name="stars" value="3" id="s3"><label for="s3"><i class="fas fa-star"></i></label>
                    <input type="radio" name="stars" value="2" id="s2"><label for="s2"><i class="fas fa-star"></i></label>
                    <input type="radio" name="stars" value="1" id="s1"><label for="s1"><i class="fas fa-star"></i></label>
                </div>
            </div>
        </div>

        <!-- Message -->
        <div class="field">
            <label class="label required">Message</label>
            <textarea class="textarea" name="Message" rows="5" placeholder="Tell us what's on your mind..." required></textarea>
        </div>

        <!-- Submit -->
        <button type="submit" id="submitBtn" class="btn-submit">
            <span class="btn-text">Send Message</span>
            <span class="btn-spinner" style="display:none"><i class="fas fa-circle-notch fa-spin"></i> Sending...</span>
        </button>

        <!-- Footer -->
        <p class="form-footer">
            By sending, you agree to our <a href="/Terms&amp;Conditions">Terms &amp; Conditions</a>.
        </p>
    </form>

    <!-- Response area (hidden until submit) -->
    <div id="formResponse" class="form-response" style="display:none"></div>
</section>

<script src="/Assets/Scripts/tickets.js"></script>
