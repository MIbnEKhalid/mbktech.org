<link rel="stylesheet" href="/Assets/Style/tickets.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<section class="track-container">
    <div class="track-hero">
        <h1>Track Your Ticket</h1>
        <p>Enter your ticket number to check the status of your support request.</p>
    </div>

    <div class="track-search-card">
        <form id="trackSearchForm" class="track-search-row">
            <input
                type="text"
                id="ticketNumberInput"
                class="input"
                placeholder="e.g., T000123456"
                maxlength="10"
                pattern="T[0-9]{9}"
                title="Format: T followed by 9 digits"
                required
            >
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-search"></i> Search
            </button>
            <button type="button" id="clearSearch" class="btn btn-ghost">
                Clear
            </button>
        </form>
        <div id="trackStatus" class="track-status"></div>
    </div>

    <!-- Ticket Result -->
    <div id="ticketResult" class="ticket-result"></div>

    <!-- Not Found -->
    <div id="ticketNotFound" class="ticket-not-found">
        <h3><i class="fas fa-exclamation-circle"></i> Ticket Not Found</h3>
        <p>No ticket matches that number. Please double-check and try again.</p>
        <p style="margin-top:0.5rem;">
            Need help? <a href="/Support&Contact" style="color:var(--primary);">Contact Support</a>
        </p>
    </div>
</section>

<script src="/Assets/Scripts/tickets.js"></script>
