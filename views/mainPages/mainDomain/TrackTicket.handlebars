<!-- ============================================================
     TRACK TICKET PAGE — MBK Tech
     Hooks preserved for /Assets/Scripts/tickets.js
     ============================================================ -->

<!-- Page hero -->
<section class="relative overflow-hidden bg-slate-50">
    <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-primary-100/60 blur-3xl"></div>
    <div class="container relative py-16 text-center md:py-20">
        <span class="inline-flex items-center gap-2 rounded-full bg-primary-50 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-primary-600 ring-1 ring-primary-100">
            <i class="lni lni-ticket"></i> Support
        </span>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight md:text-5xl">Track Your Ticket</h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-500">Enter your ticket number to check the status of your support request.</p>
    </div>
</section>

<section class="section">
    <div class="container max-w-2xl">
        <!-- Search card -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-8 dark:bg-slate-800">
            <h2 class="text-lg font-bold">Search a ticket</h2>
            <p class="mt-1 text-sm text-slate-500">Format: T followed by 9 digits, e.g. T000123456</p>

            <form id="trackSearchForm" class="mt-5 flex flex-col gap-3 sm:flex-row">
                <label for="ticketNumberInput" class="sr-only">Ticket number</label>
                <input
                    type="text"
                    id="ticketNumberInput"
                    class="w-full flex-1 rounded-lg border-slate-300 font-mono text-sm shadow-sm focus:border-primary-500 focus:ring-primary-500"
                    placeholder="e.g., T000123456"
                    maxlength="10"
                    pattern="T[0-9]{9}"
                    title="Format: T followed by 9 digits"
                    required
                >
                <button type="submit" class="btn-primary"><i class="fas fa-search"></i> Search</button>
                <button type="button" id="clearSearch" class="btn-ghost">Clear</button>
            </form>

            <div id="trackStatus" class="mt-3"></div>
        </div>

        <!-- Ticket Result (populated by tickets.js) -->
        <div id="ticketResult" class="ticket-result mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-8 dark:bg-slate-800"></div>

        <!-- Not Found -->
        <div id="ticketNotFound" class="mt-8">
            <h3 class="flex items-center justify-center gap-2 text-lg font-bold text-red-600"><i class="fas fa-exclamation-circle"></i> Ticket Not Found</h3>
            <p class="mt-2 text-center text-sm text-slate-500">No ticket matches that number. Please double-check and try again.</p>
            <p class="mt-4 text-center text-sm">
                Need help? <a href="/Support&Contact" class="font-semibold text-primary-600 hover:underline">Contact Support</a>
            </p>
        </div>
    </div>
</section>

<script src="/Assets/Scripts/tickets.js"></script>
