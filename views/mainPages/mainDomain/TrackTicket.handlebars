<!-- ============================================================
     TRACK TICKET PAGE — MBK Tech 
     Hooks strictly preserved for /assets/js/tickets.js
     ============================================================ -->

<!-- Page Header Hero -->
<section class="relative overflow-hidden py-14 sm:py-20">
    <div class="container relative z-10 text-center max-w-3xl space-y-4">
        <span class="eyebrow inline-flex items-center gap-2 rounded-full bg-primary-50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-primary-700 border border-primary-600/20 dark:bg-primary-950/70 dark:text-primary-300 dark:border-primary-500/30">
            <i class="lni lni-ticket"></i> Ticket Lookup
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl text-slate-900 dark:text-white">
            Track Your <span class="text-primary-600 dark:text-primary-400">Ticket</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
            Enter your 10-character ticket tracking ID to retrieve real-time status updates and resolution history.
        </p>
    </div>
</section>

<!-- ================= SEARCH CARD ================= -->
<section class="section pt-0">
    <div class="container max-w-2xl space-y-6">
        <!-- Search Card -->
        <div class="card p-6 sm:p-8 shadow-md border-primary-600/20 space-y-4">
            <div>
                <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <i class="lni lni-search-alt text-primary-600"></i> Search by Ticket Number
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Format: <span class="font-mono font-bold text-primary-600">T</span> followed by 9 digits (e.g. <span class="font-mono">T000123456</span>)</p>
            </div>

            <form id="trackSearchForm" class="flex flex-col sm:flex-row gap-2.5" novalidate>
                <label for="ticketNumberInput" class="sr-only">Ticket number</label>
                <div class="relative flex-1">
                    <input
                        type="text"
                        id="ticketNumberInput"
                        class="w-full rounded-lg border border-primary-600/20 bg-white/90 dark:bg-dark-surface/90 px-3.5 py-2.5 font-mono text-sm shadow-sm focus:border-primary-600 focus:ring-2 focus:ring-primary-500/20 dark:border-primary-500/25 dark:text-white uppercase placeholder:normal-case"
                        placeholder="e.g. T000123456"
                        maxlength="10"
                        pattern="T[0-9]{9}"
                        title="Format: T followed by 9 digits"
                        required
                    >
                </div>
                <button type="submit" class="btn-primary shrink-0 text-sm font-bold shadow-sm">
                    <i class="fas fa-search"></i> Search
                </button>
                <button type="button" id="clearSearch" class="btn-outline shrink-0 text-sm">
                    Clear
                </button>
            </form>

            <div id="trackStatus" class="mt-2"></div>
        </div>

        <!-- Ticket Result Container (controlled via .visible class by tickets.js) -->
        <div id="ticketResult" class="ticket-result card p-6 sm:p-8 shadow-md border-primary-600/20"></div>

        <!-- Not Found Card (controlled via .visible class by tickets.js) -->
        <div id="ticketNotFound" class="card p-6 sm:p-8 text-center border-red-200 bg-red-50/60 dark:bg-red-950/20 space-y-2">
            <h3 class="flex items-center justify-center gap-2 text-base font-bold text-red-600 dark:text-red-400">
                <i class="fas fa-exclamation-circle text-lg"></i> Ticket Not Found
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
                No matching support ticket found. Please verify the ID format or check your confirmation email.
            </p>
            <div class="pt-2">
                <a href="/Support&Contact" class="btn-primary text-xs">Open New Support Ticket</a>
            </div>
        </div>
    </div>
</section>

<script src="/assets/js/tickets.js"></script>
