<!-- ============================================================
     FAQS PAGE — MBK Tech (loads /Assets/FAQs/faq.json)
     ============================================================ -->

<!-- Page hero -->
<section class="relative overflow-hidden bg-slate-50">
    <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-primary-100/60 blur-3xl"></div>
    <div class="container relative py-16 text-center md:py-20">
        <span class="inline-flex items-center gap-2 rounded-full bg-primary-50 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-primary-600 ring-1 ring-primary-100">
            <i class="lni lni-question-circle"></i> Help Center
        </span>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight md:text-5xl">Frequently Asked Questions</h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-500">
            Answers to the questions we hear most often. Can't find what you need?
            <a href="/Support&Contact" class="font-semibold text-primary-600 hover:underline">Contact support</a>.
        </p>
    </div>
</section>

<section class="section">
    <div class="container max-w-3xl">
        <!-- Loader -->
        <div id="faqLoader" class="flex flex-col items-center justify-center py-16 text-slate-500">
            <svg class="h-8 w-8 animate-spin text-primary-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <p class="mt-3 text-sm">Loading FAQs...</p>
        </div>

        <!-- Error -->
        <div id="faqError" class="flex flex-col items-center py-16 text-center" style="display:none">
            <i class="fas fa-exclamation-circle text-3xl text-red-500"></i>
            <p class="mt-3 text-sm text-slate-500">Couldn't load FAQs. Please try refreshing the page.</p>
        </div>

        <!-- FAQ list (rendered from faq.json) -->
        <div id="faqContainer"></div>
    </div>
</section>

<script>
(function () {
    var container = document.getElementById("faqContainer");
    var loader = document.getElementById("faqLoader");
    var errorEl = document.getElementById("faqError");
    if (!container) return;

    function slugify(text) {
        return text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    }

    function getUrlTarget() {
        var qp = new URLSearchParams(window.location.search).get("Q");
        if (qp) return { type: "id", value: qp };
        var path = window.location.pathname.replace(/\/+$/, "");
        var match = path.match(/^\/FAQs?\/(.+)$/i);
        if (match) return { type: "slug", value: match[1].toLowerCase() };
        return null;
    }

    var urlTarget = getUrlTarget();

    fetch("/Assets/FAQs/faq.json")
        .then(function (r) {
            if (!r.ok) throw new Error("Failed");
            return r.json();
        })
        .then(function (data) {
            loader.style.display = "none";

            var target = null;
            var showVals = ["true", "True", "1", "Yes", "yes", "Y", "y"];
            var fragment = document.createDocumentFragment();

            data.forEach(function (item, i) {
                if (showVals.indexOf(item.display) === -1) return;

                var div = document.createElement("div");
                div.className = "faq-item";
                div.innerHTML =
                    '<div class="faq-question" id="' + item.id + '">' + item.question + '</div>' +
                    '<div class="faq-answer"><div style="padding:10px">' + item.answer + '</div></div>';
                fragment.appendChild(div);

                // Staggered fade-in
                setTimeout(function () { div.classList.add("ready"); }, i * 60);

                if (urlTarget) {
                    var m = false;
                    if (urlTarget.type === "id" && item.id === urlTarget.value) m = true;
                    if (urlTarget.type === "slug" && slugify(item.question) === urlTarget.value) m = true;
                    if (m) { div.classList.add("active"); target = div; }
                }
            });

            container.appendChild(fragment);

            // Scroll to target after expansion animation
            if (target) {
                setTimeout(function () {
                    var top = target.getBoundingClientRect().top + window.scrollY - 100;
                    window.scrollTo({ top: top, behavior: "smooth" });
                }, 500);
            }
        })
        .catch(function () {
            loader.style.display = "none";
            errorEl.style.display = "block";
        });

    // Click delegation
    container.addEventListener("click", function (e) {
        var question = e.target.closest(".faq-question");
        if (question) question.parentNode.classList.toggle("active");
    });
})();
</script>