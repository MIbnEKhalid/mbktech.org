<link rel="stylesheet" href="/Assets/Style/FAQs.css">

<style>
    .faq-page { padding: 120px 2rem 3rem; max-width: 800px; margin: 0 auto; }
    .faq-page .title { text-align: center; margin-bottom: 2.5rem; }
    .faq-page .title span { font-size: 2rem; font-weight: 700; color: var(--primary); }

    /* Loader */
    .faq-loader {
        text-align: center; padding: 3rem 0; color: var(--text-light);
    }
    .faq-loader .spinner {
        display: inline-block; width: 32px; height: 32px;
        border: 3px solid rgba(255,255,255,0.1); border-top-color: var(--primary);
        border-radius: 50%; animation: faqSpin 0.7s linear infinite;
        margin-bottom: 0.75rem;
    }
    @keyframes faqSpin { to { transform: rotate(360deg); } }

    /* Fade in items */
    .faq-item { opacity: 0; transform: translateY(8px); transition: opacity 0.3s, transform 0.3s; }
    .faq-item.ready { opacity: 1; transform: none; }

    /* Error state */
    .faq-error {
        text-align: center; padding: 3rem 1rem; color: var(--text-light);
        display: none;
    }
    .faq-error i { font-size: 2.5rem; color: #ef4444; margin-bottom: 0.75rem; display: block; }
</style>

<div class="faq-page">
    <div class="title"><span>Frequently Asked Questions</span></div>

    <!-- Loader -->
    <div class="faq-loader" id="faqLoader">
        <div class="spinner"></div>
        <div>Loading FAQs...</div>
    </div>

    <!-- Error -->
    <div class="faq-error" id="faqError">
        <i class="fas fa-exclamation-circle"></i>
        <div>Couldn't load FAQs. Please try refreshing the page.</div>
    </div>

    <div class="faq-container" id="faqContainer"></div>
</div>

<script>
(function () {
    var container = document.getElementById("faqContainer");
    var loader = document.getElementById("faqLoader");
    var errorEl = document.getElementById("faqError");
    if (!container) return;

    function slugify(text) {
        return text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    }

    function getUrlTarget() {
        var qp = new URLSearchParams(window.location.search).get("Q");
        if (qp) return { type: "id", value: qp };
        var path = window.location.pathname.replace(/\/+$/, "");
        var match = path.match(/^\/FAQs?\/(.+)$/i);
        if (match) return { type: "slug", value: match[1].toLowerCase() };
        return null;
    }

    var urlTarget = getUrlTarget();

    fetch("/Assets/FAQs/faq.json")
        .then(function (r) {
            if (!r.ok) throw new Error("Failed");
            return r.json();
        })
        .then(function (data) {
            loader.style.display = "none";

            var target = null;
            var showVals = ["true", "True", "1", "Yes", "yes", "Y", "y"];
            var fragment = document.createDocumentFragment();

            data.forEach(function (item, i) {
                if (showVals.indexOf(item.display) === -1) return;

                var div = document.createElement("div");
                div.className = "faq-item";
                div.innerHTML =
                    '<div class="faq-question" id="' + item.id + '">' + item.question + '</div>' +
                    '<div class="faq-answer"><div style="padding:10px">' + item.answer + '</div></div>';
                fragment.appendChild(div);

                // Staggered fade-in
                setTimeout(function () { div.classList.add("ready"); }, i * 60);

                if (urlTarget) {
                    var m = false;
                    if (urlTarget.type === "id" && item.id === urlTarget.value) m = true;
                    if (urlTarget.type === "slug" && slugify(item.question) === urlTarget.value) m = true;
                    if (m) { div.classList.add("active"); target = div; }
                }
            });

            container.appendChild(fragment);

            // Scroll to target after expansion animation
            if (target) {
                setTimeout(function () {
                    var top = target.getBoundingClientRect().top + window.scrollY - 100;
                    window.scrollTo({ top: top, behavior: "smooth" });
                }, 500);
            }
        })
        .catch(function () {
            loader.style.display = "none";
            errorEl.style.display = "block";
        });

    // Click delegation
    container.addEventListener("click", function (e) {
        var question = e.target.closest(".faq-question");
        if (question) question.parentNode.classList.toggle("active");
    });
})();
</script>