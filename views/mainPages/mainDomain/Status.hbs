<!-- ============================================================
     SERVICE STATUS PAGE — MBK Tech 
     Alpine.js live reachability and health checks
     ============================================================ -->

<!-- Page Header Hero -->
<section class="relative overflow-hidden py-14 sm:py-20">
    <div class="container relative z-10 text-center max-w-3xl space-y-4">
        <span class="eyebrow inline-flex items-center gap-2 rounded-full bg-primary-50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-primary-700 border border-primary-600/20 dark:bg-primary-950/70 dark:text-primary-300 dark:border-primary-500/30">
            <i class="lni lni-signal"></i> Operational Health
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl text-slate-900 dark:text-white">
            System &amp; Service <span class="text-primary-600 dark:text-primary-400">Status</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
            Real-time reachability and uptime status across all public apps, APIs, portals, and cloud services in the MBK Tech ecosystem.
        </p>
    </div>
</section>

<!-- ================= STATUS DASHBOARD ================= -->
<section class="section pt-0" x-data="statusChecker()" x-init="checkAll()">
    <div class="container max-w-3xl space-y-6">

        <!-- Status Summary Banner -->
        <div class="card p-6 sm:p-7 shadow-md border-primary-600/20 flex flex-col sm:flex-row items-center justify-between gap-4 bg-gradient-to-r from-primary-900/10 via-white/80 to-teal-900/10 dark:from-primary-950/40 dark:via-dark-surface dark:to-teal-950/40">
            <div class="flex items-center gap-3.5">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-600/20 dark:bg-emerald-950/60 dark:text-emerald-400">
                    <i class="lni lni-checkmark-circle text-2xl"></i>
                </div>
                <div>
                    <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">All Systems Operational</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Services are reachable and performing normally.</p>
                </div>
            </div>

            <button type="button" @click="checkAll()" class="btn-primary text-xs sm:text-sm shadow-sm gap-2">
                <i class="lni lni-reload" :class="checking ? 'animate-spin' : ''"></i>
                <span x-text="checking ? 'Checking...' : 'Refresh Status'"></span>
            </button>
        </div>

        <!-- Service List Card -->
        <div class="card p-6 sm:p-8 shadow-md border-primary-600/20 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-primary-600/10 dark:border-primary-500/20">
                <h3 class="text-sm font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Monitored Endpoints</h3>
                <span class="text-xs text-slate-500 dark:text-slate-400">
                    <template x-if="lastChecked"><span>Updated: <span class="font-mono text-primary-600 dark:text-primary-400" x-text="lastChecked"></span></span></template>
                </span>
            </div>

            <!-- List of Services -->
            <ul class="divide-y divide-primary-600/10 dark:divide-primary-500/15">
                <template x-for="svc in services" :key="svc.url">
                    <li class="flex items-center justify-between gap-4 py-3.5 transition-colors hover:bg-primary-50/40 dark:hover:bg-primary-950/30 px-3 rounded-lg">
                        <div class="flex min-w-0 items-center gap-3">
                            <span
                                class="h-3 w-3 shrink-0 rounded-full"
                                :class="{
                                    'bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]': svc.status === 'up',
                                    'bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.5)]': svc.status === 'down',
                                    'bg-amber-400 animate-pulse': svc.status === 'checking',
                                    'bg-slate-300 dark:bg-slate-700': !svc.status
                                }"
                            ></span>
                            <div class="min-w-0">
                                <p class="truncate text-sm font-bold text-slate-900 dark:text-white" x-text="svc.name"></p>
                                <a :href="svc.url" target="_blank" rel="noopener"
                                   class="truncate font-mono text-xs text-slate-400 transition hover:text-primary-600 dark:text-slate-500 dark:hover:text-primary-400"
                                   x-text="svc.url"></a>
                            </div>
                        </div>

                        <!-- Status Badge -->
                        <div>
                            <span
                                class="status-badge"
                                :class="{
                                    'resolved': svc.status === 'up',
                                    'closed': svc.status === 'down',
                                    'pending': svc.status === 'checking'
                                }"
                                x-text="svc.status === 'up' ? 'Operational' : svc.status === 'down' ? 'Unreachable' : svc.status === 'checking' ? 'Checking…' : 'Pending'"
                            ></span>
                        </div>
                    </li>
                </template>
            </ul>

            <!-- Disclaimer -->
            <div class="pt-3 border-t border-primary-600/10 dark:border-primary-500/20 text-xs text-slate-400 dark:text-slate-500 flex items-center justify-between">
                <span>Client-side heartbeat ping check</span>
                <a href="/Support&Contact" class="text-primary-600 dark:text-primary-400 hover:underline">Report Outage</a>
            </div>
        </div>
    </div>
</section>

<script>
    function statusChecker() {
        return {
            services: [
                { name: "MBK Tech Main Domain", url: "https://mbktech.org" },
                { name: "Engineering Blog", url: "https://blog.mbktech.org" },
                { name: "Web Portal & Bucket Admin", url: "https://core.mbktech.org" },
                { name: "Chat Application", url: "https://chat.mbktech.org" },
                { name: "AI Assistant API", url: "https://chatapi.mbktech.org" },
                { name: "Unilib Student Resources", url: "https://unilib.mbktech.org" },
                { name: "Download Portal", url: "https://download.mbktech.org" },
            ],
            checking: false,
            lastChecked: null,
            async check(svc) {
                svc.status = "checking";
                const controller = new AbortController();
                const timer = setTimeout(() => controller.abort(), 6000);
                try {
                    await fetch(svc.url, { mode: "no-cors", cache: "no-store", signal: controller.signal });
                    svc.status = "up";
                } catch (e) {
                    svc.status = "down";
                } finally {
                    clearTimeout(timer);
                }
            },
            async checkAll() {
                this.checking = true;
                await Promise.all(this.services.map((s) => this.check(s)));
                this.checking = false;
                this.lastChecked = new Date().toLocaleTimeString();
            },
        };
    }
</script>
