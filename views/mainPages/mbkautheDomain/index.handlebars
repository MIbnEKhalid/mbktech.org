}).<span class="text-yellow-300">then</span>(r => r.<span class="text-yellow-300">json</span>());

console.<span class="text-yellow-300">log</span>(<span class="text-emerald-300">`Open to approve:\n  ${init.verification_url}\n`</span>);

<span class="text-slate-500">// Poll for issued token</span>
<span class="text-purple-400">for</span> (;;) {
  <span class="text-purple-400">await</span> <span class="text-yellow-300">sleep</span>(init.interval * <span class="text-amber-300">1000</span>);
  <span class="text-purple-400">const</span> res = <span class="text-purple-400">await</span> <span class="text-yellow-300">fetch</span>(<span class="text-emerald-300">"https://portal.mbktech.org/api/cli/device/token"</span>, {
    method: <span class="text-emerald-300">"POST"</span>,
    headers: { <span class="text-emerald-300">"Content-Type"</span>: <span class="text-emerald-300">"application/json"</span> },
    body: JSON.<span class="text-yellow-300">stringify</span>({ device_code: init.device_code })
  }).<span class="text-yellow-300">then</span>(r => r.<span class="text-yellow-300">json</span>());

  <span class="text-purple-400">if</span> (res.status === <span class="text-emerald-300">"approved"</span>) {
    console.<span class="text-yellow-300">log</span>(<span class="text-emerald-300">`Logged in as ${res.username}. Token: ${res.token}`</span>);
    <span class="text-purple-400">break</span>;
  }
}</code></pre>
        </div>

        <!-- Tab 4: API Tokens -->
