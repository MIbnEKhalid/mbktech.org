                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-0.5 text-xs font-semibold text-emerald-700 border border-emerald-600/20 dark:bg-emerald-950/80 dark:text-emerald-300 dark:border-emerald-500/30 font-mono">
