<!-- Copy command snippet script -->
<script>
function copyInstallCmd(btn, cmd) {
    navigator.clipboard.writeText(cmd).then(function () {
        var orig = btn.innerHTML;
        btn.innerHTML = '<i class="lni lni-checkmark"></i> <span>Copied!</span>';
        setTimeout(function () { btn.innerHTML = orig; }, 1500);
    });
}
</script>
