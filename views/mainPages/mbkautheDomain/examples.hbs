        <!-- Recipe 1: Express App -->
        <div class="card p-6 sm:p-8 border-primary-600/20 space-y-4 shadow-md">
            <div class="flex items-center justify-between border-b border-primary-600/10 dark:border-primary-500/20 pb-4">
                <div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white">1. Minimal Express Application Setup</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Initialize Express, mount MBKAuthe, and protect public and private routes.</p>
                </div>
                <span class="badge-teal font-mono">server.ts</span>
            </div>
            <div class="card p-0 overflow-hidden bg-slate-950 text-slate-200">
                <pre class="p-5 font-mono text-xs leading-relaxed overflow-x-auto text-slate-300"><code><span class="text-purple-400">import</span> express <span class="text-purple-400">from</span> <span class="text-emerald-300">"express"</span>;
<span class="text-purple-400">import</span> mbkauthe, { sessVal, roleChk, sessPerm } <span class="text-purple-400">from</span> <span class="text-emerald-300">"mbkauthe"</span>;
<span class="text-purple-400">import</span> { definePermissions } <span class="text-purple-400">from</span> <span class="text-emerald-300">"mbkauthe/core"</span>;
<span class="text-purple-400">import</span> { syncAppPermissions } <span class="text-purple-400">from</span> <span class="text-emerald-300">"mbkauthe/services"</span>;

<span class="text-blue-400">const</span> app = <span class="text-yellow-300">express</span>();
app.<span class="text-yellow-300">use</span>(express.<span class="text-yellow-300">json</span>());

<span class="text-slate-500">// 1. Mount MBKAuthe core router (/mbkauthe/*)</span>
app.<span class="text-yellow-300">use</span>(mbkauthe);

<span class="text-slate-500">// 2. Public route</span>
app.<span class="text-yellow-300">get</span>(<span class="text-emerald-300">"/"</span>, (req, res) => res.<span class="text-yellow-300">send</span>(<span class="text-emerald-300">"Home Page"</span>));

<span class="text-slate-500">// 3. Protected user dashboard</span>
app.<span class="text-yellow-300">get</span>(<span class="text-emerald-300">"/dashboard"</span>, sessVal, (req, res) => {
  res.<span class="text-yellow-300">send</span>(<span class="text-emerald-300">`Hello ${req.session.user.username}!`</span>);
});

<span class="text-slate-500">// 4. Superadmin role check</span>
app.<span class="text-yellow-300">get</span>(<span class="text-emerald-300">"/admin"</span>, sessVal, <span class="text-yellow-300">roleChk</span>(<span class="text-emerald-300">"superadmin"</span>), (req, res) => {
  res.<span class="text-yellow-300">send</span>(<span class="text-emerald-300">"Superadmin Control Area"</span>);
});

app.<span class="text-yellow-300">listen</span>(<span class="text-amber-300">3000</span>, () => console.<span class="text-yellow-300">log</span>(<span class="text-emerald-300">"Server running at http://localhost:3000"</span>));</code></pre>
            </div>
        </div>

        <!-- Recipe 2: Dual DB Repository -->
        <div class="card p-6 sm:p-8 border-primary-600/20 space-y-4 shadow-md">
            <div class="flex items-center justify-between border-b border-primary-600/10 dark:border-primary-500/20 pb-4">
                <div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white">2. Dual-Database Repository with Transactions</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Extend BaseRepository for seamless PostgreSQL and SQLite support.</p>
                </div>
                <span class="badge-teal font-mono">ProjectRepository.ts</span>
            </div>
            <div class="card p-0 overflow-hidden bg-slate-950 text-slate-200">
                <pre class="p-5 font-mono text-xs leading-relaxed overflow-x-auto text-slate-300"><code><span class="text-purple-400">import</span> { BaseRepository, dblogin, dialect } <span class="text-purple-400">from</span> <span class="text-emerald-300">"mbkauthe/db"</span>;

<span class="text-purple-400">export interface</span> Project {
  id: <span class="text-blue-400">number</span>;
  name: <span class="text-blue-400">string</span>;
  owner_id: <span class="text-blue-400">number</span>;
}

<span class="text-purple-400">export class</span> ProjectRepository <span class="text-purple-400">extends</span> BaseRepository&lt;Project&gt; {
  <span class="text-yellow-300">constructor</span>() {
    <span class="text-purple-400">super</span>(<span class="text-emerald-300">"projects"</span>, dblogin, dialect);
  }

  <span class="text-purple-400">async</span> <span class="text-yellow-300">findByOwner</span>(ownerId: <span class="text-blue-400">number</span>): <span class="text-blue-400">Promise</span>&lt;Project[]&gt; {
    <span class="text-purple-400">return this</span>.<span class="text-yellow-300">findMany</span>({ owner_id: ownerId });
  }

  <span class="text-purple-400">async</span> <span class="text-yellow-300">transferOwnership</span>(projectId: <span class="text-blue-400">number</span>, newOwnerId: <span class="text-blue-400">number</span>) {
    <span class="text-purple-400">return await this</span>.<span class="text-yellow-300">withTransaction</span>(<span class="text-purple-400">async</span> (txRepo) => {
      <span class="text-purple-400">await</span> txRepo.<span class="text-yellow-300">query</span>(
        <span class="text-emerald-300">"UPDATE projects SET owner_id = $1 WHERE id = $2"</span>,
        [newOwnerId, projectId]
      );
    });
  }
}</code></pre>
            </div>
        </div>

        <!-- Recipe 3: Server-to-Server Auth -->
        <div class="card p-6 sm:p-8 border-primary-600/20 space-y-4 shadow-md">
            <div class="flex items-center justify-between border-b border-primary-600/10 dark:border-primary-500/20 pb-4">
                <div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white">3. Server-to-Server Webhook Protection</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Protect internal microservice endpoints using authenticate(token).</p>
                </div>
                <span class="badge-teal font-mono">webhooks.ts</span>
            </div>
            <div class="card p-0 overflow-hidden bg-slate-950 text-slate-200">
                <pre class="p-5 font-mono text-xs leading-relaxed overflow-x-auto text-slate-300"><code><span class="text-purple-400">import</span> { authenticate } <span class="text-purple-400">from</span> <span class="text-emerald-300">"mbkauthe"</span>;
<span class="text-purple-400">import</span> { mbkautheVar } <span class="text-purple-400">from</span> <span class="text-emerald-300">"mbkauthe/config"</span>;

<span class="text-slate-500">// Requires Authorization: Bearer &lt;MAIN_SECRET_TOKEN&gt;</span>
app.<span class="text-yellow-300">post</span>(
  <span class="text-emerald-300">"/api/internal/deploy-trigger"</span>,
  <span class="text-yellow-300">authenticate</span>(mbkautheVar.MAIN_SECRET_TOKEN),
  (req, res) => {
    res.<span class="text-yellow-300">json</span>({ success: <span class="text-amber-300">true</span>, message: <span class="text-emerald-300">"Deploy initiated"</span> });
  }
);</code></pre>
            </div>
        </div>

