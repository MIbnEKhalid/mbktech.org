<!-- ============================================================
     DOWNLOAD PAGE — MBK Tech (download.mbktech.org)
     ============================================================ -->

<!-- Page hero -->
<section class="relative overflow-hidden bg-slate-50">
    <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-primary-100/60 blur-3xl"></div>
    <div class="container relative py-16 text-center md:py-20">
        <span class="inline-flex items-center gap-2 rounded-full bg-primary-50 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-primary-600 ring-1 ring-primary-100">
            <i class="lni lni-mobile"></i> Apps
        </span>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight md:text-5xl">Download Apps</h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-500">Get our apps for the best experience on your device.</p>
    </div>
</section>

<section class="section">
    <div class="container max-w-2xl">
        <div class="card overflow-hidden p-0">
            <!-- App icon banner -->
            <div class="flex items-center justify-center bg-gradient-to-br from-primary-50 to-accent-50 py-12">
                <span class="flex h-20 w-20 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-600 to-accent-500 text-4xl text-white shadow-lg">
                    <i class="lni lni-mobile"></i>
                </span>
            </div>
            <div class="p-6 md:p-8">
                <h2 class="text-xl font-bold">MBK Tech App</h2>
                <p class="mt-2 text-sm leading-relaxed text-slate-500">
                    A lightweight Android app that provides quick access to all MBK Tech services through a clean web view interface.
                </p>
                <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-5 text-xs text-slate-400">
                    <span>Version {{mainAppLink.VersionNumber}}</span>
                    <span>4.2 MB</span>
                </div>
                <a href="{{mainAppLink.Url}}" download class="btn-primary mt-5 w-full">
                    <i class="lni lni-download"></i> Download APK
                </a>
            </div>
        </div>
    </div>
</section>