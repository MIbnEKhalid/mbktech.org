<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{#if title}}{{title}}{{else}}MBK Tech | Open-Source &amp; Innovation Studio{{/if}}</title>

    <meta name="description" content="MBKTech.org — Open-source innovation and technology solutions. Web development, mobile apps, custom software, and consulting from a collaborative development studio." />
    <meta name="keywords" content="MBKTech.org, Open-Source, Software Development, Technology Solutions, MBK Tech" />
    <meta property="og:title" content="MBKTech.org | Open-Source and Innovation" />
    <meta property="og:description" content="Empowering technology through open-source innovation and collaborative development." />
    <meta property="og:image" content="https://mbktech.org/assets/images/Icon/logo.png" />
    <meta property="og:url" content="https://mbktech.org/" />

    <link rel="icon" type="image/svg+xml" href="/M.png" />

    <!-- Google Fonts: Sora, IBM Plex Sans, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Icons: LineIcons + Font Awesome -->
    <link rel="stylesheet" href="https://cdn.lineicons.com/4.0/lineicons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Tailwind (compiled) -->
    <link rel="stylesheet" href="/assets/css/tailwind.css" />

    <!-- Optional page-specific head content -->
    {{{headExtra}}}

    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>

    <!-- Dark / light theme initialization -->
    <script>
        (function () {
            try {
                var stored = localStorage.getItem("mbk-theme");
                var dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
                if (dark) document.documentElement.classList.add("dark");
            } catch (e) { /* ignore */ }
        })();
        window.toggleTheme = function () {
            var root = document.documentElement;
            var dark = root.classList.toggle("dark");
            try { localStorage.setItem("mbk-theme", dark ? "dark" : "light"); } catch (e) { /* ignore */ }
        };
    </script>
</head>

<body class="flex min-h-screen flex-col font-sans antialiased">

    {{> header}}

    <main class="flex-1">
        {{{body}}}
    </main>

    {{> footer}}

    <!-- Cookie consent banner -->
    <div id="cookie"></div>
    <script src="/assets/js/cookie.js"></script>

</body>

</html>
